# GEMINI_API_KEY: Required for Gemini AI API calls.
# - In Google AI Studio: automatically injected at runtime from user secrets.
# - On Cloudflare Pages (*.pages.dev): set GEMINI_API_KEY in Dashboard ->
#   Workers & Pages -> Settings -> Variables and Secrets (or `npx wrangler pages secret put GEMINI_API_KEY`).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

